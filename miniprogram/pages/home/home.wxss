.home-page {
  min-height: 100vh;
  padding-bottom: 104rpx;
  background: #f6f8fb;
  color: #111827;
}

.circle-hero {
  position: relative;
  height: 260rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #1f6feb 0%, #4f9eff 50%, #7eb5ff 100%);
}

.hero-bg {
  position: absolute;
  inset: 0;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.9) 82%, #f6f8fb);
}

.circle-info {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  bottom: 34rpx;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.app-logo {
  width: 88rpx;
  height: 88rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #1f6feb;
  text-align: center;
  line-height: 88rpx;
  font-size: 36rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.12);
}

.circle-copy {
  flex: 1;
  min-width: 0;
}

.circle-title {
  min-width: 0;
  overflow: hidden;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1.18;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #111827;
}

.circle-members {
  margin-top: 8rpx;
  color: #4b5563;
  font-size: 24rpx;
}

/* 车次绑定状态条 */
.train-bar {
  margin: 0 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e5e9f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  margin-top: -20rpx;
  position: relative;
  z-index: 2;
}

.train-bound {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.train-unbound {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.train-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: #1f6feb;
  color: #ffffff;
  text-align: center;
  line-height: 56rpx;
  font-size: 26rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.train-icon.unbound {
  background: #e5e9f0;
  color: #6b7280;
  font-size: 36rpx;
  line-height: 52rpx;
}

.train-info {
  flex: 1;
  min-width: 0;
}

.train-no {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.train-status {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.train-arrow {
  flex-shrink: 0;
  color: #9ca3af;
  font-size: 36rpx;
  line-height: 1;
}

/* 提醒行 */
.notice-row {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 28rpx 0;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8edf3;
}

.notice-label {
  color: #EB5757;
  font-size: 24rpx;
  font-weight: 800;
}

.notice-text {
  overflow: hidden;
  color: #4b5563;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 筛选标签 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
  padding: 16rpx 24rpx 12rpx;
}

.feature-tile {
  min-width: 0;
  height: 52rpx;
  padding: 0 6rpx;
  border: 1rpx solid #dbe4ef;
  border-radius: 8rpx;
  background: #ffffff;
  text-align: center;
  box-sizing: border-box;
}

.feature-tile.active {
  border-color: #1f6feb;
  background: #1f6feb;
  box-shadow: 0 10rpx 24rpx rgba(31, 111, 235, 0.2);
}

.feature-name {
  overflow: hidden;
  color: #111827;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 50rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-tile.active .feature-name {
  color: #ffffff;
}

/* 规则提示 */
.rule-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 56rpx;
  margin: 0 24rpx 14rpx;
  padding: 0 18rpx;
  border: 1rpx solid #fde68a;
  border-radius: 8rpx;
  background: #fffbeb;
  box-sizing: border-box;
}

.rule-strong {
  flex: 0 0 auto;
  color: #92400e;
  font-size: 23rpx;
  font-weight: 900;
}

.rule-text {
  flex: 1;
  overflow: hidden;
  color: #92400e;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 信息流 */
.feed-list {
  padding: 0 24rpx 18rpx;
}

.post-card {
  position: relative;
  margin-bottom: 16rpx;
  padding: 24rpx 24rpx 22rpx;
  border: 1rpx solid #edf1f6;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
  transition: background 0.2s;
}

.post-card.resolved {
  opacity: 0.65;
}

.post-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.post-author {
  flex: 1;
  overflow: hidden;
  color: #6b7280;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.post-tag {
  flex: 0 0 auto;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 21rpx;
  line-height: 42rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.tag-help {
  background: #fee2e2;
  color: #dc2626;
}

.tag-offer {
  background: #dcfce7;
  color: #16a34a;
}

.tag-topic {
  background: #ede9fe;
  color: #7c3aed;
}

.post-title {
  margin-top: 14rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.3;
}

.post-desc {
  margin-top: 10rpx;
  color: #374151;
  font-size: 28rpx;
  line-height: 1.52;
}

.post-meta {
  margin-top: 14rpx;
  color: #9ca3af;
  font-size: 23rpx;
}

.resolved-tag {
  margin-left: 12rpx;
  color: #27AE60;
  font-weight: 700;
}

/* 空状态 */
.empty-feed {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 30rpx;
  color: #6b7280;
  font-weight: 600;
}

.empty-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* 底部搜索 */
.bottom-search {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(6rpx + env(safe-area-inset-bottom));
  z-index: 9;
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 72rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e6ebf2;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}

.search-icon {
  color: #2563eb;
  font-size: 30rpx;
  line-height: 1;
}

.search-placeholder {
  overflow: hidden;
  color: #9ca3af;
  font-size: 25rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 隐私提示弹窗 */
.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-modal {
  width: 600rpx;
  padding: 36rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
  margin-bottom: 24rpx;
  color: #111827;
}

.privacy-content {
  margin-bottom: 28rpx;
}

.privacy-item {
  font-size: 26rpx;
  color: #374151;
  line-height: 1.8;
  margin-bottom: 8rpx;
}
