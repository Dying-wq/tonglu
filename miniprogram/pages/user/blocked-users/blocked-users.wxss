.blocked-page {
  padding: 28rpx;
  background: #f5f7fb;
  min-height: 100vh;
  box-sizing: border-box;
}

.page-head {
  margin-bottom: 24rpx;
}

.head-title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 900;
}

.head-desc {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.6;
}

.blocked-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #edf1f6;
  border-radius: 12rpx;
  background: #ffffff;
}

.avatar {
  flex: 0 0 auto;
  width: 82rpx;
  height: 82rpx;
  border-radius: 8rpx;
  background: #94a3b8;
  color: #ffffff;
  text-align: center;
  line-height: 82rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.avatar.avatar-img {
  display: block;
  background: #e5eaf0;
}

.meta {
  flex: 1;
  min-width: 0;
}

.name {
  overflow: hidden;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub {
  margin-top: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.unblock-btn {
  flex: 0 0 auto;
  height: 58rpx;
  padding: 0 26rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 29rpx;
  color: #334155;
  line-height: 56rpx;
  font-size: 25rpx;
  font-weight: 700;
}

.empty-hint {
  padding: 140rpx 40rpx;
  text-align: center;
}

.empty-title {
  color: #6b7280;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 12rpx;
  color: #9ca3af;
  font-size: 25rpx;
  line-height: 1.6;
}
