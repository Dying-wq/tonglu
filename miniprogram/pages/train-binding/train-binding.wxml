<view class="page train-binding-page">
  <view class="binding-hero">
    <view class="hero-icon">列车</view>
    <view class="hero-title">绑定你的车次</view>
    <view class="hero-desc">绑定后即可看到同车旅客的求助与帮助信息，到站后自动解除。</view>
  </view>

  <view wx:if="{{currentBinding}}" class="current-binding-card">
    <view class="card-label">当前绑定</view>
    <view class="binding-info">
      <view class="binding-train">{{currentBinding.trainNo}}</view>
      <view class="binding-detail">{{currentBinding.carriageNo}}车厢{{currentBinding.seatNo ? ' · ' + currentBinding.seatNo + '座' : ''}}</view>
    </view>
    <view class="binding-meta">已绑定 · {{bindingRemaining || '到站后自动解除'}}</view>
    <view wx:if="{{arrivalText}}" class="binding-meta">预计到站时间：{{arrivalText}}</view>
    <button class="ghost-button unbind-btn" bindtap="unbind">解除绑定</button>
  </view>

  <view class="form-section">
    <view class="form-item">
      <view class="form-label">车次号</view>
      <input
        class="form-input"
        placeholder="如 K1234、G5678"
        value="{{trainNo}}"
        data-field="trainNo"
        bindinput="updateField"
        maxlength="10"
      />
    </view>

    <view class="form-item">
      <view class="form-label">车厢号</view>
      <input
        class="form-input"
        placeholder="如 5"
        value="{{carriageNo}}"
        data-field="carriageNo"
        bindinput="updateField"
        type="number"
        maxlength="3"
      />
    </view>

    <view class="form-item">
      <view class="form-label">座位号（选填）</view>
      <input
        class="form-input"
        placeholder="如 12A"
        value="{{seatNo}}"
        data-field="seatNo"
        bindinput="updateField"
        maxlength="5"
      />
    </view>

    <view class="form-item">
      <view class="form-label">到达时间（选填）</view>
      <view class="arrival-row">
        <picker mode="date" start="{{dateStart}}" value="{{arrivalDate}}" bindchange="onArrivalDateChange">
          <view class="arrival-picker {{arrivalDate ? '' : 'placeholder'}}">{{arrivalDate || '选择日期'}}</view>
        </picker>
        <picker mode="time" value="{{arrivalTime}}" bindchange="onArrivalTimeChange">
          <view class="arrival-picker {{arrivalTime ? '' : 'placeholder'}}">{{arrivalTime || '选择时间'}}</view>
        </picker>
        <view wx:if="{{arrivalDate || arrivalTime}}" class="arrival-clear" bindtap="clearArrival">清除</view>
      </view>
      <view class="form-hint">{{arrivalHint}}</view>
    </view>
  </view>

  <view class="tips-section">
    <view class="tip-item">- 同车次旅客才能看到你的求助和帮助信息</view>
    <view class="tip-item">- 到达终点站后绑定自动解除</view>
    <view class="tip-item">- 支持中途修改（换乘或坐错车厢）</view>
    <view class="tip-item">- 座位号仅用于辅助识别，非必填</view>
  </view>

  <button class="primary-button submit-btn" bindtap="submitBinding" disabled="{{submitting}}">
    {{submitting ? '绑定中...' : (currentBinding ? '修改绑定' : '确认绑定')}}
  </button>
</view>
