.train-binding-page {
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.binding-hero {
  padding: 48rpx 36rpx 36rpx;
  text-align: center;
}

.hero-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 20rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #1f6feb, #4f9eff);
  color: #ffffff;
  line-height: 120rpx;
  font-size: 32rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 40rpx rgba(31, 111, 235, 0.28);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 900;
  color: #111827;
}

.hero-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.5;
}

.current-binding-card {
  margin: 0 28rpx 28rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #eef4ff, #f0f7ff);
  border: 1rpx solid #c7dbff;
}

.card-label {
  font-size: 24rpx;
  color: #1f6feb;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.binding-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.binding-train {
  font-size: 48rpx;
  font-weight: 900;
  color: #111827;
  letter-spacing: 2rpx;
}

.binding-detail {
  font-size: 30rpx;
  color: #374151;
  font-weight: 600;
}

.binding-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.unbind-btn {
  margin-top: 20rpx;
  border-color: #EB5757;
  color: #EB5757;
}

.form-section {
  margin: 0 28rpx 28rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #e5e9f0;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  color: #374151;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid #d8dee9;
  background: #f9fafb;
  font-size: 30rpx;
  color: #111827;
  box-sizing: border-box;
}

/* 到达时间选择：日期 + 时间 并排 */
.arrival-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.arrival-row picker {
  flex: 1;
}

.arrival-picker {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid #d8dee9;
  background: #f9fafb;
  font-size: 28rpx;
  color: #111827;
  text-align: center;
}

.arrival-picker.placeholder {
  color: #9aa4b2;
}

.arrival-clear {
  flex: none;
  font-size: 26rpx;
  color: #1f6feb;
  padding: 0 8rpx;
}

.form-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a94a6;
  line-height: 1.6;
}

.tips-section {
  margin: 0 28rpx 28rpx;
  padding: 24rpx 28rpx;
  border-radius: 12rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
}

.tip-item {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.8;
}

.submit-btn {
  margin: 0 28rpx;
}
