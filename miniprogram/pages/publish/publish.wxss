.train-info-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #eef4ff, #f0f7ff);
  border: 1rpx solid #c7dbff;
}

.train-badge {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: #1f6feb;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.train-detail {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.train-hint {
  font-size: 22rpx;
  color: #6b7280;
}

.train-warning {
  padding: 20rpx;
  margin-bottom: 24rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  border: 1rpx solid #fdba74;
  text-align: center;
  color: #9a3412;
  font-size: 26rpx;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.type-card {
  min-width: 0;
  min-height: 128rpx;
  padding: 22rpx;
  border: 1rpx solid #e5e9f0;
  border-radius: 12rpx;
  background: #ffffff;
  font-size: 26rpx;
  text-align: center;
  box-sizing: border-box;
}

.type-card.active {
  border-color: #1f6feb;
  background: #eef4ff;
  color: #1f6feb;
}

.type-icon {
  margin-bottom: 8rpx;
  font-size: 40rpx;
  font-weight: 900;
}

.form-card {
  margin-bottom: 16rpx;
}

input,
textarea {
  width: 100%;
  min-height: 76rpx;
  margin-bottom: 18rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e5e9f0;
  border-radius: 8rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

textarea {
  min-height: 180rpx;
  padding-top: 18rpx;
  line-height: 1.45;
}

.risk-warning {
  padding: 12rpx 18rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
  background: #fee2e2;
  border: 1rpx solid #fca5a5;
  color: #dc2626;
  font-size: 24rpx;
}

.image-card {
  margin-bottom: 24rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.image-item,
.add-image {
  position: relative;
  aspect-ratio: 1;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f1f5f9;
}

.image-item image {
  display: block;
  width: 100%;
  height: 100%;
}

.remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 38rpx;
  height: 38rpx;
  border-radius: 19rpx;
  background: rgba(15, 23, 42, 0.72);
  color: #ffffff;
  text-align: center;
  line-height: 34rpx;
  font-size: 30rpx;
}

.add-image {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #cbd5e1;
  color: #64748b;
  font-size: 24rpx;
  box-sizing: border-box;
}

.plus {
  margin-bottom: 8rpx;
  font-size: 44rpx;
  line-height: 1;
}

.image-tip {
  margin-top: 16rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.45;
}

.publish-tips {
  margin-bottom: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
}

.tip-item {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.8;
}
