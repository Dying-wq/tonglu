.intro-card {
  padding: 30rpx;
  border-radius: 8rpx;
  background: #111827;
  color: #ffffff;
}

.intro-title {
  font-size: 38rpx;
  font-weight: 900;
}

.intro-subtitle {
  margin-top: 12rpx;
  color: #d1d5db;
  font-size: 26rpx;
  line-height: 1.55;
}

.reason-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.reason {
  min-height: 74rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  color: #374151;
  line-height: 74rpx;
  font-size: 26rpx;
  text-align: center;
}

.reason.active {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
  font-weight: 800;
}

.content-input,
.target-input {
  width: 100%;
  margin-bottom: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
  font-size: 27rpx;
}

.content-input {
  min-height: 240rpx;
  line-height: 1.5;
}

.target-input {
  height: 78rpx;
}
