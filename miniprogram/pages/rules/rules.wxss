.rules-page {
  background: #f6f8fb;
}

.hero {
  padding: 32rpx;
  border-radius: 8rpx;
  background: #111827;
  color: #ffffff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 900;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: #d1d5db;
  font-size: 26rpx;
}

.rule-card {
  display: flex;
  gap: 20rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border: 1rpx solid #edf1f6;
  border-radius: 8rpx;
  background: #ffffff;
}

.rule-index {
  flex: 0 0 auto;
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #eff6ff;
  color: #1d4ed8;
  text-align: center;
  line-height: 48rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.rule-main {
  flex: 1;
  min-width: 0;
}

.rule-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
}

.rule-text {
  margin-top: 8rpx;
  color: #4b5563;
  font-size: 26rpx;
  line-height: 1.5;
}
