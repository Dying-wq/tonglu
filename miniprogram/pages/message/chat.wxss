.chat-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #f6f8fb;
  box-sizing: border-box;
}

/* 顶部「正在和谁聊」：头像 + 名字 + 关联内容 */
.peer-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 8rpx;
  background: #eff6ff;
}

.peer-avatar {
  flex: 0 0 auto;
  width: 84rpx;
  height: 84rpx;
  border-radius: 8rpx;
  background: #1f6feb;
  color: #ffffff;
  text-align: center;
  line-height: 84rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.peer-avatar-img {
  display: block;
  background: #e5eaf0;
}

.peer-meta {
  flex: 1;
  min-width: 0;
}

.peer-name {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.peer-blocked-tag {
  flex: 0 0 auto;
  padding: 0 10rpx;
  height: 32rpx;
  border-radius: 16rpx;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  color: #b91c1c;
  line-height: 30rpx;
  font-size: 19rpx;
  font-weight: 800;
}

.peer-sub {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tool-row {
  display: flex;
  gap: 12rpx;
  margin: 16rpx 0;
}

.tool-chip {
  flex: 1;
  height: 54rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1d4ed8;
  text-align: center;
  line-height: 54rpx;
  font-size: 23rpx;
  font-weight: 800;
}

.tool-chip.warn {
  color: #b45309;
}

.tool-chip.dark {
  color: #111827;
}

/* 取消拉黑：用主色描边区分于「拉黑」的黑字按钮 */
.tool-chip.primary {
  background: #eff6ff;
  border: 1rpx solid #1f6feb;
  color: #1f6feb;
  line-height: 52rpx;
}

.messages {
  flex: 1;
  min-height: 420rpx;
}

.bubble {
  max-width: 78%;
  margin-bottom: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  word-break: break-word;
}

.mine {
  margin-left: auto;
  background: #1f6feb;
  color: #ffffff;
}

.other {
  border: 1rpx solid #edf1f6;
  background: #ffffff;
  color: #1f2937;
}

.bubble-risk {
  margin-top: 8rpx;
  color: #fef3c7;
  font-size: 22rpx;
}

.other .bubble-risk {
  color: #b45309;
}

.time {
  margin-top: 8rpx;
  opacity: 0.72;
  font-size: 22rpx;
}

/* 撤回后的占位：去掉气泡底色，只留一行居中灰字，
   和真实消息区分开，避免被误读成「对方发了这句话」 */
.bubble.recalled {
  background: transparent;
  color: #94a3b8;
  text-align: center;
  max-width: 100%;
  padding: 8rpx 0;
  font-size: 24rpx;
}

.recall-text {
  font-style: normal;
}

.quick-row {
  display: flex;
  gap: 10rpx;
  margin: 14rpx 0;
  overflow-x: auto;
}

.quick-chip {
  flex: 0 0 auto;
  max-width: 360rpx;
  height: 54rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 27rpx;
  background: #ffffff;
  color: #1d4ed8;
  line-height: 54rpx;
  font-size: 23rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.composer {
  display: grid;
  grid-template-columns: 1fr 132rpx;
  gap: 12rpx;
}

.composer input {
  width: 100%;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #d8dee9;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.composer button {
  width: 132rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 8rpx;
  background: #1f6feb;
  color: #ffffff;
  line-height: 76rpx;
}

/* 消息为空时的占位 */
.empty-hint {
  padding: 80rpx 24rpx;
  text-align: center;
}

.empty-title {
  color: #6b7280;
  font-size: 29rpx;
  font-weight: 700;
}

.empty-desc {
  margin-top: 12rpx;
  color: #9ca3af;
  font-size: 25rpx;
}

/* 已拉黑提示条 */
.blocked-banner {
  margin: 0 0 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  color: #b91c1c;
  font-size: 24rpx;
  line-height: 1.6;
}

/* 拉黑后输入区变为不可用状态 */
.composer-blocked {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.composer-disabled {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #f3f4f6;
  color: #9ca3af;
  font-size: 26rpx;
  text-align: center;
  box-sizing: border-box;
}

/* 输入区里的「取消拉黑」：让用户不用回到顶部工具行也能直接恢复聊天 */
.composer-unblock {
  flex: 0 0 176rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 8rpx;
  background: #1f6feb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  text-align: center;
}

/* 云函数版本不匹配时的开发提示，正常部署时不会出现 */
.deploy-hint {
  margin: 14rpx 0 0;
  padding: 14rpx 18rpx;
  border-radius: 8rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  color: #92400e;
  font-size: 23rpx;
  line-height: 1.6;
}

/* 订单会话的显性入口 */
.order-shortcut {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 24rpx 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 12rpx;
  background: #eff6ff;
  color: #1e3a8a;
  font-size: 26rpx;
}

.order-shortcut-action {
  flex: none;
  color: #2563eb;
  font-weight: 700;
}
