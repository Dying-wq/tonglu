.message-page {
  background: #f6f8fb;
}

.message-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #111827;
  color: #ffffff;
}

.head-title {
  font-size: 38rpx;
  font-weight: 900;
}

.head-subtitle {
  margin-top: 8rpx;
  color: #d1d5db;
  font-size: 24rpx;
}

.setting-chip {
  flex: 0 0 auto;
  height: 58rpx;
  padding: 0 18rpx;
  border-radius: 29rpx;
  background: #ffffff;
  color: #111827;
  line-height: 58rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.message-tabs {
  margin: 0 -28rpx 22rpx;
}

.tab-track {
  display: flex;
  gap: 12rpx;
  min-width: max-content;
  padding: 0 28rpx;
}

.tab {
  flex: 0 0 auto;
  height: 58rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5eaf0;
  border-radius: 29rpx;
  background: #ffffff;
  color: #4b5563;
  line-height: 58rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.tab.active {
  border-color: #1f6feb;
  background: #1f6feb;
  color: #ffffff;
}

/* 左滑容器：卡片在上层横向位移，操作按钮压在下面，露出时才可见 */
.conv-swipe {
  position: relative;
  margin-bottom: 18rpx;
  overflow: hidden;
  border-radius: 8rpx;
}

.swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  display: flex;
}

/* 宽度与 index.js 里的 ACTION_WIDTH / 2 对应（每个 84px，合计 168px）。
   这里必须用 px 而不是 rpx：JS 里 touch 事件的 clientX 与 offset 都是 px，
   两边单位不一致时按钮会露不全或者露出空白。 */
.swipe-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84px;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
}

.action-unread {
  background: #3b82f6;
}

.action-delete {
  background: #ef4444;
}

.conversation-card {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  padding: 24rpx;
  border: 1rpx solid #edf1f6;
  border-radius: 8rpx;
  background: #ffffff;
  transition: transform 0.22s ease;
}

/* 拖动过程中关掉过渡，否则卡片跟不上手指，表现为拖影 */
.conversation-card.dragging {
  transition: none;
}

.avatar {
  flex: 0 0 auto;
  width: 82rpx;
  height: 82rpx;
  border-radius: 8rpx;
  background: #1f6feb;
  color: #ffffff;
  text-align: center;
  line-height: 82rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.avatar-wrap {
  margin-right: 20rpx;
}

.content {
  flex: 1;
  min-width: 0;
}

.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.name {
  min-width: 0;
  overflow: hidden;
  color: #111827;
  font-size: 30rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank {
  margin-left: 8rpx;
  color: #1f6feb;
  font-size: 23rpx;
}

.time,
.last,
.related {
  color: #94a3b8;
  font-size: 24rpx;
}

.related {
  margin-top: 8rpx;
  color: #64748b;
  font-weight: 700;
}

.last {
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.unread {
  flex: 0 0 auto;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #dc2626;
  color: #ffffff;
  text-align: center;
  line-height: 36rpx;
  font-size: 22rpx;
  box-sizing: border-box;
}

/* 已拉黑的会话仍然保留在列表里，否则用户点不进去、也就无法取消拉黑 */
.conversation-card.is-blocked {
  opacity: 0.72;
}

.blocked-tag {
  flex: 0 0 auto;
  align-self: flex-start;
  padding: 0 12rpx;
  height: 34rpx;
  border-radius: 17rpx;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
  color: #b91c1c;
  line-height: 32rpx;
  font-size: 20rpx;
  font-weight: 800;
}

/* 会话为空 / 加载中 */
.conv-empty {
  padding: 120rpx 40rpx;
  text-align: center;
}

.conv-empty-title {
  color: #6b7280;
  font-size: 29rpx;
  font-weight: 700;
}

.conv-empty-desc {
  margin-top: 12rpx;
  color: #9ca3af;
  font-size: 25rpx;
  line-height: 1.6;
}

/* 真实头像（用户自己上传的），没有时才回退到文字头像 */
.avatar.avatar-img {
  background: #e5eaf0;
  display: block;
}

/* 订单会话入口：与普通会话文字区分开，发布者一眼能找到确认订单的位置 */
.order-entry {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}
