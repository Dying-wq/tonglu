<view class="page message-page">
  <view class="message-head">
    <view>
      <view class="head-title">消息中心</view>
      <view class="head-subtitle">未读 {{unreadCount}} 条 · 会话按最新消息排序</view>
    </view>
    <view class="setting-chip" bindtap="goSettings">提醒设置</view>
  </view>

  <scroll-view class="message-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="tab-track">
      <view
        wx:for="{{tabs}}"
        wx:key="*this"
        data-index="{{index}}"
        class="tab {{activeTab === index ? 'active' : ''}}"
        bindtap="selectTab"
      >
        {{item}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="conv-empty">加载中…</view>
  <view wx:elif="{{conversations.length === 0}}" class="conv-empty">
    <view class="conv-empty-title">还没有会话</view>
    <view class="conv-empty-desc">在首页找到同车次的帖子，点「私信帮 ta」开始聊天</view>
  </view>

  <view
    wx:for="{{conversations}}"
    wx:key="id"
    class="conv-swipe"
  >
    <!-- 左滑后露出的操作区，压在卡片下面。卡片左移 168px 后这里才会露出来 -->
    <view class="swipe-actions">
      <view
        class="swipe-action action-unread"
        data-index="{{index}}"
        catchtap="doMarkUnread"
      >标为未读</view>
      <view
        class="swipe-action action-delete"
        data-index="{{index}}"
        catchtap="doDelete"
      >删除</view>
    </view>

    <view
      class="conversation-card {{item.status === 'blocked' ? 'is-blocked' : ''}} {{item.dragging ? 'dragging' : ''}}"
      style="transform: translateX({{item.offset || 0}}px);"
      data-index="{{index}}"
      data-id="{{item.id}}"
      data-openid="{{item.peerOpenid}}"
      data-name="{{item.name}}"
      data-avatar="{{item.avatarText}}"
      data-avatar-url="{{item.avatarUrl}}"
      data-order-id="{{item.orderId}}"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchEnd"
      bindtap="goChat"
    >
    <view class="avatar-wrap" catchtap="goProfile" data-openid="{{item.peerOpenid}}">
  <image
    wx:if="{{item.avatarUrl}}"
    class="avatar avatar-img"
    src="{{item.avatarUrl}}"
    mode="aspectFill"
  />
  <view wx:else class="avatar">{{item.avatarText}}</view>
</view>

      <view class="content">
        <view class="line">
          <view class="name">{{item.name}} <text class="rank">{{item.rankName}}</text></view>
          <view class="time">{{item.lastMessageTime}}</view>
        </view>
        <view class="related">{{item.relatedTitle || '关联内容'}}</view>
        <view class="last">{{item.lastMessage}}</view>
        <!-- 订单会话的明显入口：发布者从这里进订单页接受接单 / 确认完成 -->
        <view
          wx:if="{{item.orderId}}"
          class="order-entry"
          data-order-id="{{item.orderId}}"
          data-conversation-id="{{item.id}}"
          catchtap="goOrder"
        >查看订单 · 接受接单 / 确认完成 ›</view>
      </view>
      <view wx:if="{{item.status === 'blocked'}}" class="blocked-tag">已拉黑</view>
      <view wx:elif="{{item.unread}}" class="unread">{{item.unread}}</view>
    </view>
  </view>
</view>
