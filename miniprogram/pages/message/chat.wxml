<view class="chat-page">
  <!-- 顶部显示「正在和谁聊」。这里必须是对方的信息：
       之前会话列表用的是建会话时写死的发布者昵称，
       发布者本人打开会看到自己的名字，头像同理。 -->
  <view class="peer-bar">
    <image
      wx:if="{{peerAvatarUrl}}"
      class="peer-avatar peer-avatar-img"
      src="{{peerAvatarUrl}}"
      mode="aspectFill"
    />
    <view wx:else class="peer-avatar">{{peerAvatarText || '旅'}}</view>
    <view class="peer-meta">
      <view class="peer-name">
        {{peerName || '同车旅客'}}
        <text wx:if="{{blocked}}" class="peer-blocked-tag">{{blockedByMe ? '已拉黑' : '被拉黑'}}</text>
      </view>
      <view class="peer-sub" bindtap="goPost">
        {{post ? post.title + ' · ' + post.location : '同路微光会话'}}
      </view>
    </view>
  </view>

  <view wx:if="{{deployHint}}" class="deploy-hint">{{deployHint}}</view>

  <!-- 单账号自测：会话里只有自己，peerOpenid 为空，页面显示默认的「同车旅客」。
       这时没有真实的拉黑对象，完整验证必须换第二个账号。 -->
  <view wx:if="{{selfOnly}}" class="deploy-hint">自测会话：这条会话里只有你自己（对方 openid 为空），拉黑 / 取消拉黑要用第二个账号才能完整验证。</view>

  <!-- 订单会话直接给出去订单确认页的入口，发布者不用再回消息页找 -->
  <view wx:if="{{orderId}}" class="order-shortcut" bindtap="goOrder">
    <text>这条会话关联了互助订单</text>
    <text class="order-shortcut-action">接受接单 / 确认完成 ›</text>
  </view>

  <view class="tool-row">
    <view class="tool-chip" bindtap="requestWechat">交换微信</view>
    <view class="tool-chip warn" bindtap="reportConversation">举报</view>
    <view wx:if="{{!blocked}}" class="tool-chip dark" bindtap="blockUser">拉黑</view>
    <view wx:elif="{{blockedByMe}}" class="tool-chip primary" bindtap="unblock">取消拉黑</view>
  </view>

  <view wx:if="{{blocked}}" class="blocked-banner">
    {{blockedByMe ? '已拉黑该用户，双方无法继续发送消息' : '对方已将你拉黑，暂时无法发送消息'}}
  </view>

  <scroll-view class="messages" scroll-y>
    <view wx:if="{{loading}}" class="empty-hint">加载中…</view>
    <view wx:elif="{{messages.length === 0}}" class="empty-hint">
      <view class="empty-title">还没有消息</view>
      <view class="empty-desc">发一条消息，和同车旅客聊聊具体需求</view>
    </view>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      class="bubble {{item.sender === 'me' ? 'mine' : 'other'}}"
    >
      <view>{{item.content}}</view>
      <view wx:if="{{item.riskStatus === 'warning'}}" class="bubble-risk">风险提醒</view>
      <view class="time">{{item.createdAt || ''}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{riskWarning && !blocked}}" class="risk-tip">{{riskWarning}}</view>

  <view wx:if="{{!blocked}}" class="quick-row">
    <view
      wx:for="{{quickReplies}}"
      wx:key="*this"
      class="quick-chip"
      data-text="{{item}}"
      bindtap="useQuickReply"
    >
      {{item}}
    </view>
  </view>

  <view wx:if="{{blocked}}" class="composer composer-blocked">
    <view class="composer-disabled">
      {{blockedByMe ? '已拉黑，无法发送消息' : '已被对方拉黑，无法发送消息'}}
    </view>
    <view wx:if="{{blockedByMe}}" class="composer-unblock" bindtap="unblock">取消拉黑</view>
  </view>
  <view wx:else class="composer">
    <input placeholder="输入消息" value="{{inputValue}}" bindinput="updateInput" />
    <button bindtap="sendText">发送</button>
  </view>
</view>
