<view class="page" wx:if="{{order}}">
  <view class="card">
    <view class="title">{{order.title}}</view>
    <view class="status">状态：{{statusText}}</view>
    <view class="muted">发布者：{{order.publisherName}}</view>
    <view class="muted">接单者：{{order.takerName}}</view>
    <view class="risk-tip">只有发布者确认完成后，订单才进入待评价。平台不托管资金，请保留沟通证据。</view>
  </view>

  <button class="ghost-button" bindtap="goChat" wx:if="{{conversationId}}">进入私聊</button>
  <button class="primary-button" bindtap="publisherAccept" wx:if="{{canAccept}}">接受接单</button>
  <button class="primary-button" bindtap="confirmComplete" wx:if="{{canConfirm}}">确认完成</button>
  <button class="ghost-button" bindtap="goReview" wx:if="{{canReview}}">去评价</button>
  <button class="ghost-button" bindtap="cancel" wx:if="{{canCancel}}">取消订单</button>
  <button class="ghost-button" bindtap="goComplaint">投诉仲裁</button>
</view>

<view class="page" wx:elif="{{loading}}">
  <view class="card muted">订单加载中…</view>
</view>

<view class="page" wx:else>
  <view class="card muted">订单不存在或无权查看</view>
</view>
