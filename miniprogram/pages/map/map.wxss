.map-page {
  min-height: 100vh;
  padding: 28rpx;
  background: #f5f7fb;
  color: #111827;
  box-sizing: border-box;
}

.map-header {
  padding: 30rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.06);
}

.map-title {
  font-size: 40rpx;
  font-weight: 900;
}

.map-subtitle {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 25rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 76rpx;
  margin-top: 24rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f3f6fa;
  box-sizing: border-box;
}

.search-icon {
  color: #2563eb;
  font-size: 30rpx;
}

.search-box input {
  flex: 1;
  color: #111827;
  font-size: 27rpx;
}

.category-scroll {
  margin: 24rpx -28rpx 0;
}

.category-track {
  display: flex;
  gap: 14rpx;
  min-width: max-content;
  padding: 0 28rpx;
}

.category-pill {
  flex: 0 0 auto;
  height: 62rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e5eaf0;
  border-radius: 8rpx;
  background: #ffffff;
  color: #4b5563;
  line-height: 62rpx;
  font-size: 25rpx;
}

.category-pill.active {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1d4ed8;
  font-weight: 800;
}

.campus-map {
  position: relative;
  height: 520rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: linear-gradient(145deg, #dff3e8, #edf7ff);
  box-shadow: inset 0 0 0 1rpx rgba(15, 23, 42, 0.06);
}

.map-ground {
  position: absolute;
  left: 80rpx;
  right: 70rpx;
  top: 86rpx;
  bottom: 78rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.42);
  transform: skewY(-12deg) rotate(-2deg);
}

.map-road {
  position: absolute;
  height: 42rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  transform: rotate(-12deg);
}

.road-main {
  left: -60rpx;
  right: -40rpx;
  top: 290rpx;
}

.road-side {
  left: 80rpx;
  right: 150rpx;
  top: 178rpx;
  transform: rotate(22deg);
}

.poi-pin {
  position: absolute;
  width: 132rpx;
  transform: translate(-50%, -50%);
  text-align: center;
}

.poi-building {
  width: 64rpx;
  height: 58rpx;
  margin: 0 auto;
  border-radius: 8rpx 8rpx 12rpx 12rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 22rpx rgba(15, 23, 42, 0.16);
  transform: skewY(-10deg);
}

.poi-pin.active .poi-building {
  background: #2563eb;
}

.poi-name {
  margin-top: 8rpx;
  color: #111827;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.2;
}

.poi-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.06);
}

.poi-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.poi-title {
  color: #111827;
  font-size: 34rpx;
  font-weight: 900;
}

.poi-category {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.nav-button {
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 8rpx;
  background: #111827;
  color: #ffffff;
  line-height: 58rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.poi-desc {
  margin-top: 18rpx;
  color: #4b5563;
  font-size: 27rpx;
  line-height: 1.5;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag {
  height: 46rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #f3f6fa;
  color: #374151;
  line-height: 46rpx;
  font-size: 23rpx;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.ghost-button,
.primary-button {
  height: 76rpx;
  border-radius: 8rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 76rpx;
}

.ghost-button {
  border: 1rpx solid #dbeafe;
  background: #eff6ff;
  color: #1d4ed8;
}

.primary-button {
  background: #2563eb;
  color: #ffffff;
}
