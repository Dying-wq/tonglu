.detail-card {
  margin-bottom: 24rpx;
}

.title {
  flex: 1;
  min-width: 0;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
}

.tag {
  flex: 0 0 auto;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 21rpx;
  line-height: 42rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.tag-help {
  background: #fee2e2;
  color: #dc2626;
}

.tag-offer {
  background: #dcfce7;
  color: #16a34a;
}

.tag-topic {
  background: #ede9fe;
  color: #7c3aed;
}

.image-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.detail-image {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 8rpx;
  background: #f1f5f9;
}

.desc {
  margin-top: 24rpx;
  color: #374151;
  font-size: 28rpx;
  line-height: 1.7;
}

.meta,
.publisher {
  margin-top: 16rpx;
  color: #64748b;
  font-size: 26rpx;
}

.meta-item {
  margin-right: 20rpx;
}

.resolved-banner {
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 8rpx;
  background: #dcfce7;
  color: #16a34a;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.action-area {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.complaint {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  margin-top: 24rpx;
  padding: 0;
  background: transparent;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.2;
}

/* 帖子评论：沿用详情页卡片风格，避免另起一套视觉 */
.comment-card {
  margin-top: 24rpx;
}

.comment-head {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.comment-empty {
  padding: 24rpx 0;
  color: #94a3b8;
  font-size: 26rpx;
  text-align: center;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.comment-avatar {
  flex: none;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #e2e8f0;
  color: #475569;
  font-size: 26rpx;
  line-height: 56rpx;
  text-align: center;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.comment-name {
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}

.comment-time {
  flex: none;
  color: #94a3b8;
  font-size: 22rpx;
}

.comment-content {
  margin-top: 6rpx;
  color: #1e293b;
  font-size: 27rpx;
  line-height: 1.5;
  word-break: break-all;
}

.comment-remove {
  flex: none;
  margin-left: 12rpx;
  padding: 4rpx 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.comment-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.comment-input {
  flex: 1;
  min-width: 0;
  padding: 14rpx 18rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  background: #f8fafc;
  color: #1e293b;
  font-size: 26rpx;
}

.comment-send {
  flex: none;
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 10rpx;
  background: #2563eb;
  color: #fff;
  font-size: 26rpx;
}

.comment-send[disabled] {
  background: #cbd5e1;
  color: #fff;
}
