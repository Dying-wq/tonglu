.admin-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: #f6f8fb;
  color: #111827;
}

.admin-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 34rpx 30rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #111827, #2563eb);
  color: #ffffff;
}

.eyebrow {
  margin-bottom: 10rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.ghost-btn,
.small-btn,
.mini-btn,
.action-btn {
  margin: 0;
  border-radius: 8rpx;
  line-height: 1;
}

.ghost-btn {
  flex: 0 0 126rpx;
  height: 60rpx;
  padding: 0;
  background: rgba(255, 255, 255, 0.14);
  color: #ffffff;
  font-size: 24rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 22rpx 18rpx;
  border: 1rpx solid #edf1f7;
  border-radius: 8rpx;
  background: #ffffff;
}

.stat-card.alert .stat-value {
  color: #dc2626;
}

.stat-value {
  color: #111827;
  font-size: 38rpx;
  font-weight: 800;
}

.stat-label {
  color: #6b7280;
  font-size: 22rpx;
}

.module-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-top: 22rpx;
}

.module-chip {
  min-width: 0;
  padding: 16rpx 0;
  border: 1rpx solid #dfe5ee;
  border-radius: 8rpx;
  background: #ffffff;
  color: #4b5563;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
}

.module-chip.active {
  border-color: #2563eb;
  background: #eaf2ff;
  color: #1d4ed8;
}

.panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #edf1f7;
  border-radius: 8rpx;
  background: #ffffff;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 800;
}

.panel-desc {
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.small-btn {
  flex: 0 0 122rpx;
  height: 56rpx;
  padding: 0;
  background: #111827;
  color: #ffffff;
  font-size: 22rpx;
}

.empty {
  padding: 44rpx 0;
  color: #9ca3af;
  text-align: center;
  font-size: 24rpx;
}

.record-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #eef2f7;
}

.record-main {
  display: flex;
  min-width: 0;
  flex: 1;
  gap: 16rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 56rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f1f5f9;
  color: #111827;
  font-size: 24rpx;
  font-weight: 800;
}

.record-body {
  min-width: 0;
}

.record-title {
  overflow: hidden;
  color: #111827;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  font-weight: 800;
}

.record-subtitle,
.record-meta {
  overflow: hidden;
  margin-top: 8rpx;
  color: #6b7280;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 22rpx;
}

.record-meta {
  color: #9ca3af;
}

.record-side {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  gap: 12rpx;
  flex: 0 0 160rpx;
}

.status-pill {
  max-width: 154rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #374151;
  font-size: 20rpx;
}

.record-actions {
  display: flex;
  gap: 8rpx;
}

.mini-btn {
  width: 72rpx;
  height: 48rpx;
  padding: 0;
  background: #eef2ff;
  color: #1d4ed8;
  font-size: 20rpx;
}

.mini-btn.danger {
  background: #fef2f2;
  color: #dc2626;
}

.action-bar {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.action-btn {
  height: 76rpx;
  padding: 0;
  background: #ffffff;
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
}

.action-btn.primary {
  background: #2563eb;
  color: #ffffff;
}
